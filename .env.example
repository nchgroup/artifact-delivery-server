GITEA_URL="https://gitea.example.com"
GITEA_TOKEN="xxxxx"
REPOSITORY_OWNER="admin"
REPOSITORY_NAME="rubeus"
WORKFLOW_NAME="build.yml"
WORKFLOW_REF="master"
SERVER_TOKEN="a-long-random-token"
DECRYPTION_KEY="Rubeus.xor.key"
ENCRYPTED_FILE="Rubeus.xor"

# Optional access guardrails:
# ALLOWED_HOST="delivery.example.tld"
# ALLOWED_CLIENT_IPS="203.0.113.10,192.168.1.0/24,10.0.0.5-10"
# ALLOWED_CLIENT_IPS_FILE="./ips.txt"
# TRUSTED_PROXY_PRESET="localhost"
# TRUSTED_PROXIES="127.0.0.1/32,10.0.0.0/8"
# CLIENT_HEADERS_FILE="./client-headers.txt"
# REQUEST_SIGNING_KEY_FILE="./request-signing.key"
# REQUEST_SIGNING_WINDOW="60s"

# Optional response headers and Server banner:
# SERVER_BANNER="Microsoft-IIS/10.0"
# SERVER_HEADERS_FILE="./server-headers.txt"

# Optional mTLS client verification (requires TLS):
# TLS_CLIENT_CA_FILE="./client-ca.crt"
